{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Sour Labs Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#31323B",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/SourLabsLogo.png",
    "dark": "/images/SourLabsLogo.png"
  },
  "navigation": {
    "pages": [
      "index"
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://discord.gg/sourlabs"
        },
        {
          "anchor": "Control Panel",
          "icon": "computer",
          "href": "https://panel.sourlabs.co.uk"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/SourLabsLogo.png",
    "dark": "/images/SourLabsLogo.png",
    "href": "https://sourlabs.co.uk"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "assistant"
    ]
  },
  "description": "The documentation for Sour Labs. The one-point hub to find any information and learn how to use a system.",
  "appearance": {
    "default": "dark"
